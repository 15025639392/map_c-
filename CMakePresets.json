{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "native-tests",
      "displayName": "Native Debug With Tests",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/native-tests",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "native-tests", "configurePreset": "native-tests" }
  ],
  "testPresets": [
    {
      "name": "native-tests",
      "configurePreset": "native-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
